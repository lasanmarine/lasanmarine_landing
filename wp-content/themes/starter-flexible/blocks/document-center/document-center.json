{
  "key": "group_document_center",
  "title": "Document Center",
  "fields": [
    { "key": "field_dc_label", "label": "Block Label", "name": "label", "type": "text" },
    { "key": "field_dc_all_label", "label": "\"All\" Tab Label", "name": "all_label", "type": "text", "default_value": "TẤT CẢ", "instructions": "Tab đầu tiên hiển thị toàn bộ tài liệu." },
    {
      "key": "field_dc_groups", "label": "Groups", "name": "groups", "type": "repeater",
      "layout": "block", "button_label": "Add Group",
      "instructions": "Mỗi nhóm là một tab. Tài liệu nằm bên trong nhóm của nó.",
      "sub_fields": [
        { "key": "field_dc_group_name", "label": "Group Name", "name": "name", "type": "text", "wrapper": { "width": "100" } },
        {
          "key": "field_dc_group_items", "label": "Documents", "name": "items", "type": "repeater",
          "layout": "table", "button_label": "Add Document",
          "sub_fields": [
            { "key": "field_dc_item_title", "label": "Title", "name": "title", "type": "text", "wrapper": { "width": "45" } },
            { "key": "field_dc_item_size", "label": "Size", "name": "size", "type": "text", "wrapper": { "width": "15" } },
            { "key": "field_dc_item_file", "label": "File", "name": "file", "type": "file", "return_format": "url", "wrapper": { "width": "40" } }
          ]
        }
      ]
    },
    { "key": "field_dc_empty_text", "label": "Empty Text", "name": "empty_text", "type": "text", "default_value": "Không có kết quả." },
    { "key": "field_dc_custom_class", "label": "Custom Class", "name": "custom_class", "type": "text", "required": 0 }
  ],
  "location": [[{ "param": "block", "operator": "==", "value": "acf/document-center" }]]
}
