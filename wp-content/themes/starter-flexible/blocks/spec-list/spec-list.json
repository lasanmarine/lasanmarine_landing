      "layout": "row", "button_label": "Add Row",
      "sub_fields": [
        { "key": "field_spec_list_row_label", "label": "Label", "name": "label", "type": "text" },
        { "key": "field_spec_list_row_value", "label": "Value", "name": "value", "type": "text" }
      ]
    },
    { "key": "field_spec_list_custom_class", "label": "Custom Class", "name": "custom_class", "type": "text", "required": 0 }
  ],
  "location": [[{ "param": "block", "operator": "==", "value": "acf/spec-list" }]]
