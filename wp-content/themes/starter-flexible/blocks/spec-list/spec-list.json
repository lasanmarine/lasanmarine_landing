{
  "key": "group_spec_list",
  "title": "Spec List",
  "fields": [
    { "key": "field_spec_list_heading", "label": "Heading", "name": "heading", "type": "text" },
    { "key": "field_spec_list_heading_level", "label": "Heading Level", "name": "heading_level", "type": "select", "choices": { "h2": "H2", "h1": "H1 (page has no hero)" }, "default_value": "h2", "return_format": "value" },
    { "key": "field_spec_list_note", "label": "Note", "name": "note", "type": "textarea", "rows": 3, "new_lines": "" },
    {
